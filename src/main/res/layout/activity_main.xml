<?xml version="1.0" encoding="utf-8"?>
<!--
  状态主屏 · activity_main.xml
  ============================================
  ★ 信息层级（自上而下）：
      标题 → 状态大字（唯一主角）→ 三个关键指标 → 主操作按钮 → 参数入口

  ★ 为什么把参数全部收走：
    原界面把 4 组滑块全铺在首屏，用户的真实诉求只有两个：
    「现在什么状态」和「我要不要开/停」。参数是低频需求，
    移到二级页，首屏因此能在 3 秒内读完。

  ★ 尺寸换算：750px 画板 ÷ 2 = dp
    页面边距 32px → 16dp；卡片内边距 48px → 24dp
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="@dimen/space_l">

            <!-- ===== 顶部标题栏 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_l">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_title"
                        android:textAppearance="@style/TextAppearance.DouZaiMa.Title"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/main_subtitle_idle"
                        android:textAppearance="@style/TextAppearance.DouZaiMa.Caption"
                        android:textColor="@color/on_surface_muted" />
                </LinearLayout>

                <!-- 设置入口 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_settings"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="@string/action_settings"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="24dp"
                    app:iconTint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- ===== 状态主卡 ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/status_card"
                style="@style/Widget.DouZaiMa.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <!-- ★ 不要再加纵向 padding：卡片样式已有 24dp contentPadding，
                         重复叠加会让状态卡虚高 32dp -->

                    <!-- 状态光点：呼吸动画暗示「正在看着」
     ★ 光晕与光点同尺寸（40dp），靠 scale 动画做扩散。
       （clipChildren=false 只影响绘制、不影响测量，
        若给光晕设更大尺寸，父容器会被撑高） -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <View
                            android:id="@+id/status_glow"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_status_glow" />

                        <View
                            android:id="@+id/status_dot"
                            android:layout_width="@dimen/status_dot"
                            android:layout_height="@dimen/status_dot"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_status_dot" />
                    </FrameLayout>

                    <!-- 状态大字：整个首屏的视觉主角 -->
                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/state_idle"
                        android:textAppearance="@style/TextAppearance.DouZaiMa.Hero"
                        android:textColor="@color/on_surface_muted"
                        tools:text="有人" />

                    <!-- 状态说明 -->
                    <TextView
                        android:id="@+id/status_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:gravity="center"
                        android:text="@string/hint_idle"
                        android:textAppearance="@style/TextAppearance.DouZaiMa.Body"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 关键指标 ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DouZaiMa.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- 帧率 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/metric_fps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/metric_value_placeholder"
                            android:textAppearance="@style/TextAppearance.DouZaiMa.Metric"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/metric_fps"
                            android:textAppearance="@style/TextAppearance.DouZaiMa.Caption"
                            android:textColor="@color/on_surface_muted" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@color/outline" />

                    <!-- 推理耗时 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/metric_infer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/metric_value_placeholder"
                            android:textAppearance="@style/TextAppearance.DouZaiMa.Metric"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/metric_infer"
                            android:textAppearance="@style/TextAppearance.DouZaiMa.Caption"
                            android:textColor="@color/on_surface_muted" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:background="@color/outline" />

                    <!-- 置信度 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/metric_confidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/metric_value_placeholder"
                            android:textAppearance="@style/TextAppearance.DouZaiMa.Metric"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/metric_confidence"
                            android:textAppearance="@style/TextAppearance.DouZaiMa.Caption"
                            android:textColor="@color/on_surface_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 主操作 ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle"
                style="@style/Widget.DouZaiMa.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_start"
                app:icon="@drawable/ic_play"
                app:iconSize="22dp"
                app:iconGravity="textStart" />

            <!-- ===== 参数入口 ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_settings"
                style="@style/Widget.DouZaiMa.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/action_settings"
                app:icon="@drawable/ic_tune"
                app:iconSize="20dp"
                app:iconGravity="textStart" />

            <!-- ===== 副信息：绑核状态 ===== -->
            <TextView
                android:id="@+id/pin_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.DouZaiMa.Caption"
                android:textColor="@color/on_surface_muted"
                android:visibility="gone"
                tools:text="已绑小核 cpu0-3"
                tools:visibility="visible" />

            <!-- ===== 副信息：本机地址（电脑端要填的就是这个） =====
                 ★ 做成可点的：点一下就复制「IP:端口」，
                   省得用户对着屏幕手抄一串数字。 -->
            <TextView
                android:id="@+id/net_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.DouZaiMa.Caption"
                android:textColor="@color/on_surface_muted"
                tools:text="手机地址 192.168.1.5:8765 · 点按复制" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
